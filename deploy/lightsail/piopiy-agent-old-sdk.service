[Unit]
Description=Piopiy Old SDK Gemini Live Sandbox Worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/new_voice_agent
EnvironmentFile=/opt/new_voice_agent/.env
Environment=PYTHONUNBUFFERED=1
Environment=PIOPIY_OLD_SDK_TRACE_FILE=/opt/new_voice_agent/runtime/piopiy_old_sdk_trace.jsonl
ExecStart=/opt/new_voice_agent-piopiy/.venv/bin/python /opt/new_voice_agent/scripts/run_piopiy_old_sdk_gemini_agent.py
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/new_voice_agent /opt/new_voice_agent-piopiy
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
